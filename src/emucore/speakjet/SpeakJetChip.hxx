  // One end of a sound: oscillators 1 to 3 by formant band (a negative
  // frequency is a silent oscillator), their levels, and the pedestal
  struct State {
    std::array<double, 3> hz{};
    std::array<double, 3> level{};
    double pedestal{0.0};
  };
  // A voiced fricative's noise: osc 4 and 5, their frequencies jittered by a
  // random value held NOISE_HOLD chip samples, scaled by distortion; half
  // enveloped means half constant, half under the grain envelope
  struct Noise {
    double hz4{0.0}, hz5{0.0};
    double distortion{0.0};
    double ratio{0.0};
    bool half{false};
    double level{0.0};
  };
  struct Sound {
    bool voiced{false};
    State start, end;
    bool glide{false};
    State onset;
    Noise noise;
  };

  // The jitter per step of distortion, and how many chip samples it is held
