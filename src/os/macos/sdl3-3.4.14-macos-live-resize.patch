diff --git a/src/video/cocoa/SDL_cocoawindow.m b/src/video/cocoa/SDL_cocoawindow.m
index 68c6ac5..fbe654d 100644
--- a/src/video/cocoa/SDL_cocoawindow.m
+++ b/src/video/cocoa/SDL_cocoawindow.m
@@ -805,6 +805,26 @@ static NSCursor *Cocoa_GetDesiredCursor(void)
     return [NSCursor invisibleCursor];
 }
 
+/* Between presented frames AppKit scales the layer's contents to the view's new
+ * bounds. Pinning them to the corner opposite the dragged edge leaves them
+ * unscaled against the edges that are holding still. */
+static void Cocoa_AnchorLiveResizeContents(NSWindow *nswindow, BOOL anchorLeft, BOOL anchorTop)
+{
+    NSView *metalview = [[nswindow contentView] viewWithTag:SDL_METALVIEW_TAG];
+    if (metalview == nil) {
+        return;  // not a Metal window
+    }
+
+    const NSViewLayerContentsPlacement placement = anchorLeft ?
+        (anchorTop ? NSViewLayerContentsPlacementTopLeft : NSViewLayerContentsPlacementBottomLeft) :
+        (anchorTop ? NSViewLayerContentsPlacementTopRight : NSViewLayerContentsPlacementBottomRight);
+
+    // Ancestors are layer-backed too and would rescale, undoing this
+    for (NSView *v = metalview; v != nil; v = [v superview]) {
+        [v setLayerContentsPlacement:placement];
+    }
+}
+
 @implementation SDL3Cocoa_WindowListener
 
 - (void)listen:(SDL_CocoaWindowData *)data
@@ -1140,6 +1160,9 @@ static NSCursor *Cocoa_GetDesiredCursor(void)
 
 - (void)windowWillStartLiveResize:(NSNotification *)aNotification
 {
+    liveResizeLastFrame = [_data.nswindow frame];
+    liveResizeHasAnchor = NO;
+
     // We'll try to maintain 60 FPS during live resizing
     const NSTimeInterval interval = 1.0 / 60.0;
     liveResizeTimer = [NSTimer scheduledTimerWithTimeInterval:interval
@@ -1275,6 +1298,29 @@ static NSCursor *Cocoa_GetDesiredCursor(void)
         }
     }
 
+    /* The frame delta names the dragged edge: Cocoa frames are bottom-left
+       based, so a moving origin.x is the left edge, origin.y the bottom.
+       Set before the events below, so the app redraws against it. */
+    if ([nswindow inLiveResize]) {
+        const NSRect frame = [nswindow frame];
+        const NSRect prev = liveResizeLastFrame;
+        const BOOL moved = !NSEqualRects(frame, prev);
+
+        liveResizeLastFrame = frame;
+        if (moved) {
+            const BOOL anchorLeft = (frame.origin.x == prev.origin.x);
+            const BOOL anchorTop = (frame.origin.y != prev.origin.y);
+
+            if (!liveResizeHasAnchor || anchorLeft != liveResizeAnchorLeft ||
+                anchorTop != liveResizeAnchorTop) {
+                liveResizeHasAnchor = YES;
+                liveResizeAnchorLeft = anchorLeft;
+                liveResizeAnchorTop = anchorTop;
+                Cocoa_AnchorLiveResizeContents(nswindow, anchorLeft, anchorTop);
+            }
+        }
+    }
+
     /* The window can move during a resize event, such as when maximizing
        or resizing from a corner */
     SDL_GlobalToRelativeForWindow(window, x, y, &x, &y);
